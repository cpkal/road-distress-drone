# Copy to .env (never commit .env)

# Database (used by docker compose and the API)
POSTGRES_USER=webdrone
POSTGRES_PASSWORD=change-me
POSTGRES_DB=webdrone
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://webdrone:change-me@localhost:5432/webdrone

# pgAdmin (used by docker compose)
PGADMIN_DEFAULT_EMAIL=admin@webdrone.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# API storage & detection settings (paths relative to api/)
DATA_DIR=data
MODELS_DIR=models
MODEL_PATH=models/best.pt
FRAME_SAMPLE_FPS=1.0
MIN_CONFIDENCE=0.25
SAHI_SLICE_HEIGHT=640
SAHI_SLICE_WIDTH=640
SAHI_OVERLAP_HEIGHT_RATIO=0.2
SAHI_OVERLAP_WIDTH_RATIO=0.2
SAHI_POSTPROCESS_TYPE=GREEDYNMM
SAHI_POSTPROCESS_MATCH_METRIC=IOS
SAHI_POSTPROCESS_MATCH_THRESHOLD=0.5
DEDUPE_RADIUS_M=5.0
MAX_VIDEO_SIZE_MB=2048
MAX_PHOTOS_PER_UPLOAD=100

# Web (Nuxt runtime config)
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NUXT_PUBLIC_MAP_DEFAULT_CENTER=107.6035,-6.9425
NUXT_PUBLIC_MAP_DEFAULT_ZOOM=14

